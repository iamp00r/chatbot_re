# 이 파일을 복사해 .env.local을 만들고 값을 채운다. .env.local은 커밋하지 않는다.
#   cp .env.example .env.local
# 명세서: docs/02_기술명세서.md §15

# ── Supabase (M0-2) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── LLM 공급사 키 (M0-5) ──
GOOGLE_GENERATIVE_AI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=            # 모더레이션용

# ── 모델 선택 ("공급사:모델명") ──
LLM_CHAT_MODEL=
LLM_EXTRACT_MODEL=
LLM_SUMMARY_MODEL=

# ── 기억 파이프라인 ──
EXTRACT_EVERY=6
SUMMARY_EVERY=20
MEMORY_TOKEN_BUDGET=1200
HISTORY_TOKEN_BUDGET=3000

# ── 운영 ──
DAILY_TOKEN_LIMIT=2000000
JOBS_SECRET=               # /api/jobs/run 호출용 비밀값 (아무 긴 랜덤 문자열)
